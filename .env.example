# Resend API key (https://resend.com). If empty, form submissions are logged to the
# server console in development instead of being emailed.
RESEND_API_KEY=

# Inbox that receives enquiries. Falls back to emails.sales in lib/site-config.ts.
CONTACT_TO_EMAIL=

# Public site URL without a trailing slash. Falls back to siteUrl in lib/site-config.ts.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional. Sender for outgoing email; must be on a domain verified in Resend.
# Defaults to "Brand Name <onboarding@resend.dev>", which only works for testing.
EMAIL_FROM=
